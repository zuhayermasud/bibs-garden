{
  "name": "bibs-garden",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:content": "bun --bun velite dev",
    "dev:next": "bun --bun next dev",
    "dev": "bun run --parallel dev:content dev:next",
    "build:content": "bun --bun velite build --clean",
    "build:next": "bun --bun next build",
    "build": "bun run --sequential build:content build:next",
    "start": "bun --bun next start",
    "lint": "bun --bun oxlint",
    "lint:fix": "bun --bun oxlint --fix",
    "fmt": "bun --bun oxfmt",
    "fmt:check": "bun --bun oxfmt --check",
    "typecheck": "bun --bun tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "velite": "^0.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "remark-breaks": "^4.0.0",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
